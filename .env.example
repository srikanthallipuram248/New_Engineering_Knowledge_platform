# Copy this file to .env and fill in the real values.
# The docker-compose.yml mounts .env into the api container.

# ── Postgres (must match docker-compose.yml service 'postgres') ────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ── Groq LLM (Agent 1 analyzer + Agent 2 chat) ────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generate-a-long-random-string-for-production
JWT_ALGORITHM=HS256

# ── Token lifetimes ───────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINITES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
